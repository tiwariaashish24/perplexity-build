
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  engineType ="client"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

// Defining the schema

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  provider      AuthProvider
  name          String
  superbaseId   String

  conversations Conversation[]
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  slug      String    @unique
  userId    String

  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  role           MessageRole
  conversationId String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

enum MessageRole {
  User
  Assistant
}

enum AuthProvider {
  Github
  Google
}
